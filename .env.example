# Neo-Cortex settings. Copy to .env, then export the values you need, for example:
#   set -a; . ./.env; set +a
# The code reads these from the process environment only; nothing loads .env automatically.
# Every value below is optional: the commented-out lines show the defaults.

# Where the embedded database and its data live (neo.rdb).
# NEO_HOME=~/.neo-cortex

# Graph database. Leave unset for embedded falkordblite (bound to 127.0.0.1).
# Set it to use a running server instead, e.g. the Docker service in docker-compose.yml.
# NEO_FALKORDB_URL=redis://localhost:6379

# Port of the embedded falkordblite server (ignored when NEO_FALKORDB_URL is set).
# NEO_PORT=6390

# Tenant (one graph per tenant, named neo_<tenant>).
# NEO_TENANT=default

# Compute device: auto (CUDA when torch sees it), cuda or cpu.
# NEO_DEVICE=auto

# Models: a local directory, or a Hugging Face hub id. If unset, the repo-local
# directory (gliner2.5-base-v1 / embeddinggemma-2) is used when present, else the hub id.
# NEO_GLINER=fastino/gliner2.5-base-v1
# NEO_EMBED=google/embeddinggemma-2

# Daemon URL used by the neo CLI and the Claude Code hooks (loopback only).
# NEO_DAEMON_URL=http://127.0.0.1:8765

# Agent identity recorded on memories and handoffs (default: claude-code, or claude-code:<session>).
# NEO_AGENT=
